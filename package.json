{
  "name": "building-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Architectural design agent powered by open-source Tencent Hunyuan Hy4, with a Vue3 + Three.js viewer",
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix web install",
    "dev": "node scripts/dev.js",
    "dev:server": "node server/src/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node server/src/index.js",
    "demo": "node scripts/smoke.js",
    "init": "node scripts/init.mjs",
    "models:vision": "node scripts/download-vision-model.mjs --model=qwen2-vl-2b --dtype=q8 && node scripts/download-vision-model.mjs --model=smolvlm-500m --dtype=q8",
    "models:check": "node scripts/download-vision-model.mjs --model=qwen2-vl-2b --dtype=q8 --check && node scripts/download-vision-model.mjs --model=smolvlm-500m --dtype=q8 --check",
    "models:hy4": "node scripts/download-hy4-model.mjs --all",
    "models:hy4:plan": "node scripts/download-hy4-model.mjs --plan",
    "models:hy4:config": "node scripts/download-hy4-model.mjs --config",
    "models:hy4:check": "node scripts/download-hy4-model.mjs --check",
    "models:vision:browser": "node scripts/download-vision-model.mjs --model=smolvlm-500m --dtype=q8",
    "models:vision:server": "node scripts/download-vision-model.mjs --model=qwen2-vl-2b --dtype=q8",
    "test:local-vision": "node scripts/test-local-vision.mjs",
    "mock:hy4": "node scripts/mock-hy4.js",
    "mock:vision": "node scripts/mock-vision.js",
    "test:hy4": "node scripts/test-hy4-loop.js",
    "test:vision": "node scripts/test-vision.js"
  },
  "engines": {
    "node": ">=18"
  }
}

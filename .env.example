# Hy4 / agent server configuration (copy to .env or export in your shell)

# auto = probe Hy4 then fall back to the local design planner
# hy4  = always use the model (fail loudly if unreachable)
# local= pure deterministic engine
AGENT_MODE=auto

HY4_BASE_URL=http://127.0.0.1:8000/v1
HY4_API_KEY=EMPTY
HY4_MODEL=hy4
# no_think (fast) or high (deep chain-of-thought)
HY4_REASONING=no_think

PORT=8787
